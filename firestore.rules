rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacherOfClass(classId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/classrooms/$(classId)) &&
        get(/databases/$(database)/documents/classrooms/$(classId)).data.teacherId == request.auth.uid;
    }

    // User profile documents & all user subcollections
    // - Authenticated users can read profiles (needed for leaderboards & teacher roster)
    // - Only the owner can write/update/delete their profile, portfolio, holdings, history, and achievements
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /{subcollection}/{docId=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Classroom documents
    match /classrooms/{classId} {
      // Authenticated users can view classrooms (students joining, teachers managing)
      allow read: if isAuthenticated();
      // Teachers can create their classroom
      allow create: if isAuthenticated() && request.resource.data.teacherId == request.auth.uid;
      // Only the assigned teacher can update or delete classroom settings
      allow update, delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;

      // Student roster
      match /roster/{studentId} {
        allow read: if isAuthenticated();
        // A student can join themselves or the teacher can enroll/update them
        allow create, update: if isAuthenticated() && (request.auth.uid == studentId || isTeacherOfClass(classId));
        // Only the teacher can remove students from the roster
        allow delete: if isTeacherOfClass(classId);
      }

      // Teacher assignments
      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow write: if isTeacherOfClass(classId);
      }

      // Classroom goals
      match /goals/{goalId} {
        allow read: if isAuthenticated();
        allow write: if isTeacherOfClass(classId);
      }

      // Classroom announcements
      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isTeacherOfClass(classId);
      }
    }

    // News articles: Publicly readable, writeable only via Firebase Admin SDK (Cloud Functions/Server Actions)
    match /news_articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // Cached market quotes: Read-only for authenticated users, updated only by Admin SDK / Cloud Functions
    match /market_quotes/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
